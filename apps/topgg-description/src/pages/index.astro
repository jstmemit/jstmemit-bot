---
import PageLayout from "#/layout/PageLayout.astro";
import HeroSection from "#/components/HeroSection.astro";
import HowDoesItWorkSection from "#/components/HowDoesItWorkSection.astro";
---

<PageLayout>
    <HeroSection />
    <section class="meme-examples-section">
        <img
            class="meme-examples"
            src="https://files.jstmemit.com/jstmemit/images/topgg/meme%20examples.png"
            alt="grid with 6 memes"
        />
    </section>
    <HowDoesItWorkSection />
</PageLayout>

<style>
    .meme-examples-section {
        margin-top: 3rem;
    }

    .meme-examples {
        width: 100%;
    }
</style>
