---

---

<section class="hero-section">
    <article class="hero-text-content">
        <p class="hero-mascot">
            <img
                alt="jstmemit's mascot logo jumping around"
                src="https://files.jstmemit.com/jstmemit/images/logos/animated/yes.webp"
            />
            Hey, I'm Jstmemit
        </p>
        <h1>
            Get <em>personalized memes</em>
            <br />&nbsp;based on chat messages, <br />&nbsp;images and GIFs
        </h1>
        <p class="hero-text-bonus">...for free and without watermarks!</p>
    </article>

    <ul>
        <a class="button" href="https://discord.com/oauth2/authorize?client_id=1375836467745783990">
            <img
                src="https://files.jstmemit.com/jstmemit/images/discord.svg"
                alt="discord logo"
                target="_blank"
                rel="noopener noreferrer"
            />
            Invite to your server
        </a>
    </ul>
</section>

<style>
    .hero-section {
        border-radius: 2rem;
        padding: 4rem;
        background-image: url("https://files.jstmemit.com/jstmemit/images/background/background%20v2.png");
        background-size: cover;
        background-position: center;

        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .hero-text-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;

        line-height: 2.75rem;

        font-weight: 800;
        font-size: 1.2rem;

        transform: rotate(-2.591deg);
    }

    h1 {
        font-size: 2rem;
    }

    .hero-mascot {
        display: flex;
        align-items: center;

        margin-top: -2rem;
        margin-left: -1rem;
        margin-bottom: -1.9rem;

        font-style: italic;
        font-weight: 900;
        line-height: normal;
    }

    .hero-mascot img {
        width: 5.5rem;
    }

    .hero-text-bonus {
        margin-top: -2.25rem;
        font-size: 0.9rem;
    }

    .button {
        background-color: var(--color-discord-blue);
        color: #fff;
        border: none;
        text-decoration: none;
        padding: 1rem 2rem;
        border-radius: 1rem;
        font-weight: 700;
        font-size: 1.25rem;
        text-shadow: var(--text-shadow-1);
        box-shadow: var(--shadow-10);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .button img {
        width: 2rem;
        margin-top: 0.25rem;
    }

    @media screen and (max-width: 1024px) {
        .hero-section {
            flex-direction: column;
            gap: 2rem;
        }

        .hero-text-content h1 br {
            display: none;
        }

        .hero-text-content h1 span {
            display: block;
        }
    }
</style>
