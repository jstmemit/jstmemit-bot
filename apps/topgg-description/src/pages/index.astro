---
import PageLayout from "#/layout/PageLayout.astro";
---

<PageLayout>
    <section class="hero-section">
        <div class="hero-text-content">
            <p class="hero-mascot">
                <img
                    alt="jstmemit's mascot logo jumping around"
                    src="https://files.jstmemit.com/jstmemit/images/logos/animated/yes.webp"
                />
                Hey, I'm Jstmemit
            </p>
            <h1>
                Get <em>personalized memes</em>
                <br /> based on chat messages, <br /> images and GIFs
            </h1>
            <p class="hero-text-bonus">...for free and without watermarks!</p>
        </div>
    </section>

    <section class="how-does-it-work-section">
        <h2>How <em>exactly</em> does that <em>work?</em></h2>
        <p class="how-does-it-work-text-content">
            <b>Just send messages like you normally would.</b>
            Once in a while Jstmemit picks a meme template, takes some GIFs, messages and mixes it all together. Resulted
            meme is sent into your channel without you having to do anything.
        </p>
        <img
            src="https://files.jstmemit.com/jstmemit/images/topgg/howDoesItWork.png"
            alt="illustration of how mixing separate messages into one meme text works"
        />
    </section>
</PageLayout>

<style>
    .hero-section {
        border-radius: 2rem;
        padding: 4rem;
        background-image: url("https://files.jstmemit.com/jstmemit/images/background/background%20v2.png");
        background-size: cover;
        background-position: center;

        display: flex;
        align-items: center;
    }

    .hero-text-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;

        line-height: 2.75rem;

        font-weight: 800;
        font-size: 1.2rem;

        transform: rotate(-2.591deg);
    }

    .hero-mascot {
        display: flex;
        align-items: center;

        margin-top: -2rem;
        margin-left: -1rem;
        margin-bottom: -1.9rem;

        font-style: italic;
        font-weight: 900;
        line-height: normal;
    }

    .hero-mascot img {
        width: 5.5rem;
    }

    em {
        color: var(--color-bubblegum-pink);
        font-weight: 800;
        font-style: normal;
    }

    .hero-text-bonus {
        margin-top: -2.25rem;
        font-size: 0.9rem;
    }

    @media screen and (max-width: 768px) {
        .hero-text-content h1 br {
            display: none;
        }

        .hero-text-content h1 span {
            display: block;
        }
    }

    h2 em {
        font-weight: 700;
    }

    .how-does-it-work-section {
        background-color: var(--color-ash-black);
        display: flex;
        justify-content: center;
        flex-direction: column;
        gap: 1rem;
        position: relative;
        padding: 3.5rem 2rem 2rem;
        border-radius: 0.5rem 0.5rem 2rem 2rem;
        margin-top: 4rem;
        border: 2px solid var(--color-bubblegum-pink);
    }

    .how-does-it-work-section h2 {
        position: absolute;
        padding: 1rem;
        background-color: var(--color-ash-black);
        border-radius: 0.8rem;
        border: 2px solid var(--color-bubblegum-pink);

        font-weight: 800;
        font-size: 1.5rem;

        top: -4rem;
    }

    p.how-does-it-work-text-content {
        color: #d4d4d4;
        line-height: 1.75rem;
        display: flex;
        gap: 0.6rem;
        flex-direction: column;
        font-size: 1.25rem;
    }

    p.how-does-it-work-text-content > b {
        font-size: 1.5rem;
        color: #fff;
    }

    .how-does-it-work-section img {
        width: 100%;
        margin-left: 1rem;
        padding-bottom: 1rem;
    }
</style>
