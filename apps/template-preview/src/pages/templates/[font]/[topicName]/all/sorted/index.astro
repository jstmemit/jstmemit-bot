---
import type { GetStaticPaths } from "astro";
import type { ITemplatesRepository } from "@jstmemit/shared/interfaces/ITemplatesRepository";
import { TemplatesRepository } from "@jstmemit/shared/repositories/TemplatesRepository";
import type { Template } from "@jstmemit/shared/models/Template";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TemplatesList from "@/components/TemplatesList.astro";
import { type FontValueType, FontValues } from "@jstmemit/shared/models/Font";
import type { TemplateTopic } from "@jstmemit/shared/models/TemplateTopic";

interface Props {
    font: FontValueType;
    templates: Template[];
}

export const getStaticPaths = (() => {
    const templatesRepository: ITemplatesRepository = new TemplatesRepository();
    const templates: Template[] = templatesRepository
        .getAll()
        .sort((a: Template, b: Template) => a.name.localeCompare(b.name));
    const uniqueTopics: TemplateTopic[] = Array.from(
        new Set(templates.flatMap((template: Template) => template.topics)),
    );
    const availableFonts: FontValueType[] = Object.values(FontValues);

    return availableFonts.flatMap((font: FontValueType) =>
        uniqueTopics.map((topic: TemplateTopic) => {
            const filteredTemplates: Template[] = templates.filter((template: Template) =>
                template.topics.includes(topic),
            );

            return {
                params: { font: font.split(" ").join("-"), topicName: topic },
                props: { font, templates: filteredTemplates },
            };
        }),
    );
}) satisfies GetStaticPaths;

const { font, templates } = Astro.props;
---

<BaseLayout>
    <TemplatesList font={font} templates={templates} />
</BaseLayout>
