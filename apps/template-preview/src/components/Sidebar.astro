---
import type { ITemplatesRepository } from "@jstmemit/shared/interfaces/ITemplatesRepository";
import { TemplatesRepository } from "@jstmemit/shared/repositories/TemplatesRepository";
import type { Template } from "@jstmemit/shared/models/Template";
import { type TemplateTopic, Topic } from "@jstmemit/shared/models/TemplateTopic";
import type { FontValueType } from "@jstmemit/shared/models/Font";

interface Props {
    currentFont?: FontValueType;
    currentTopic: TemplateTopic | "all";
    currentTemplateName?: string;
}

const templatesRepository: ITemplatesRepository = new TemplatesRepository();
const templates: Template[] = templatesRepository.getAll();
const { currentFont = "default", currentTopic, currentTemplateName = "" } = Astro.props;
const topicOptions = Object.entries(Topic).sort((a, b) => a[0].localeCompare(b[0]));
---

<nav class="flex min-w-60 flex-col gap-2">
    <div class="flex items-center justify-between">
        <a href="/" class="text-3xl font-bold md:text-2xl">Meme templates</a>
        <!--TODO: replace with some icon later-->
        <div
            id="toggle"
            class="bg-hot-fuchsia text-carbon-black rotate-180 rounded-full p-2 px-4 pt-3 pb-1 text-2xl font-black md:hidden"
        >
            ^
        </div>
    </div>
    <div>
        <label for="topic-select" class="sr-only">Choose topic</label>
        <select
            id="topic-select"
            class="focus:border-hot-fuchsia w-full rounded border border-zinc-700 bg-zinc-900 px-3 py-1.5 text-sm text-white focus:outline-none"
        >
            <option value="all" selected={currentTopic === "all"}> All topics </option>
            {
                topicOptions.map(([key, value]) => (
                    <option value={value} selected={currentTopic === value}>
                        {key}
                    </option>
                ))
            }
        </select>
    </div>
    <ul id="template-list" class="hidden max-h-200 scrollbar-thin flex-col gap-2 overflow-y-auto pt-3 md:flex">
        {
            templates
                .filter((template: Template) => {
                    if (currentTopic === "all") return true;
                    return template.topics.includes(currentTopic);
                })
                .sort((a, b) => a.name.localeCompare(b.name))
                .map((template: Template) => (
                    <li
                        template-name={template.name}
                        class={`flex justify-between gap-2.5 border-l-2 pr-3 pl-3 ${template.name === currentTemplateName ? "border-violet-500/70" : "border-hot-fuchsia/80"} hover:border-neon-ice/70 mt-1 md:mt-0`}
                    >
                        <a
                            class="truncate"
                            href={`/templates/${currentFont.split(" ").join("-")}${currentTopic === "all" ? "" : `/${currentTopic}`}/${template.name}`}
                        >
                            {template.name}
                        </a>
                        <span class="new-badge text-hot-fuchsia/80 hidden">new</span>
                    </li>
                ))
        }
    </ul>
</nav>

<script>
    function initTopicSelect() {
        const select = document.getElementById("topic-select") as HTMLSelectElement | null;
        if (!select) return;

        select.addEventListener("change", (event) => {
            const target = event.target as HTMLSelectElement;
            const selectedTopic = target.value;
            window.location.href = `/templates${selectedTopic === "all" ? "" : `/${selectedTopic}`}`;
        });
    }

    function syncMenuState() {
        const toggle: HTMLElement | null = document.getElementById("toggle");
        const list: HTMLElement | null = document.getElementById("template-list");

        if (!toggle || !list) return;

        const isMenuOpen: boolean = localStorage.getItem("menu-expanded") === "true";

        if (isMenuOpen) {
            list.classList.remove("hidden");
            toggle.classList.remove("rotate-180");
        } else {
            list.classList.add("hidden");
            toggle.classList.add("rotate-180");
        }

        toggle.replaceWith(toggle.cloneNode(true));
        const activeToggle: HTMLElement | null = document.getElementById("toggle");

        activeToggle?.addEventListener("click", () => {
            const willBeHidden: boolean = list.classList.toggle("hidden");
            activeToggle.classList.toggle("rotate-180");

            localStorage.setItem("menu-expanded", (!willBeHidden).toString());
        });
    }

    function checkNewTemplates() {
        const liElements: NodeListOf<Element> = document.querySelectorAll("#template-list li[template-name]");
        const savedTemplatesRaw: string | null = localStorage.getItem("known-templates");
        const knownNames: string[] = savedTemplatesRaw ? JSON.parse(savedTemplatesRaw) : [];

        liElements.forEach((li: Element) => {
            const name: string = li.getAttribute("template-name") || "";
            if (knownNames.length > 0 && !knownNames.includes(name)) {
                const badge: Element | null = li.querySelector(".new-badge");
                badge?.classList.remove("hidden");
            }
        });

        const currentNames: string[] = Array.from(liElements).map(
            (li: Element) => li.getAttribute("template-name") || "",
        );

        const updatedKnownTemplates = Array.from(new Set([...knownNames, ...currentNames]));

        localStorage.setItem("known-templates", JSON.stringify(updatedKnownTemplates));
    }

    initTopicSelect();
    syncMenuState();
    checkNewTemplates();

    document.addEventListener("astro:page-load", () => {
        initTopicSelect();
        syncMenuState();
        checkNewTemplates();
    });
</script>
