---
import PageLayout from "#/layout/PageLayout.astro";
import HeroSection from "#/components/HeroSection.astro";
import HowDoesItWorkSection from "#/components/HowDoesItWorkSection.astro";
import MemeExamplesSection from "#/components/MemeExamplesSection.astro";
---

<PageLayout>
    <HeroSection />
    <MemeExamplesSection />
    <HowDoesItWorkSection />
    <section class="result-section">
        <h2>Just 1 of 600+ meme templates</h2>

        <img
            class="result-meme"
            src="https://files.jstmemit.com/jstmemit/images/topgg/meme.webp"
            alt="Meme with a photo of a minecraft base and 'our base is trash' text over it"
        />
        <div class="result-text-content">
            <p class="why-jstmemit-text-block">
                <b>Understands your humour</b>
                Each generated meme has 👍 and 👎 buttons that help the bot to understand what was funny or cringe. Want to
                see more memes about, for example, Breaking Bad? Put your like on them and it'll give you more.
            </p>
            <p class="why-jstmemit-text-block">
                <b>Can be customized</b>
                You have full control over things such as how often the memes will be generated, which font will be used for
                them and others. Deleting saved channel’s meme data is a single click from /settings, if you want to start
                fresh.
            </p>
        </div>
    </section>
</PageLayout>

<style>
    .result-section {
        position: relative;
        margin-top: 5.5rem;
        display: flex;
        align-items: stretch;
        gap: 2rem;
    }

    .result-section img {
        width: 50%;
        border-radius: 2rem;
        border: 2px solid var(--color-bubblegum-pink);
    }

    .result-section h3 {
        font-weight: 700;
        margin-block-start: 0;
        margin-block-end: 0.5em;
    }

    .result-text-content {
        display: flex;
        flex-direction: column;
        min-height: 100%;
    }

    .why-jstmemit-text-block {
        padding: 2rem;
        border-radius: 2rem;
    }

    h2 {
        left: 2rem;
    }

    @media screen and (max-width: 768px) {
        .result-section {
            flex-direction: column;
        }

        .result-section img {
            width: 100%;
        }
    }
</style>
