---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Sidebar from "../../../components/Sidebar.astro";
import { type TemplateTopic, Topic } from "@jstmemit/shared/models/TemplateTopic";

export const getStaticPaths = (() => {
    return Object.values(Topic).map((topic) => ({
        params: { topicName: topic },
        props: { topic },
    }));
}) satisfies GetStaticPaths;

const { topic } = Astro.props;
---

<BaseLayout>
    <div class="flex flex-col gap-10 md:flex-row">
        <Sidebar currentTopic={topic} currentTemplateName="" />
        <hr class="text-white/20" />
        <section class="flex w-full min-w-0 flex-col gap-10">
            <div class="flex flex-col gap-1">
                <h1 class="mb-2 max-w-prose text-2xl font-black md:text-4xl">Template preview</h1>
                <p class="text-zinc-400">
                    Here you can preview meme templates and how they behave with different sorts of data on them. Choose
                    one in the sidebar to begin.
                </p>
            </div>
        </section>
    </div>
</BaseLayout>
