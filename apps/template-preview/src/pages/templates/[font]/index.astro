---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import IndexLayout from "@/layouts/IndexLayout.astro";
import { FontValues, type FontValueType } from "@jstmemit/shared/models/Font";

interface Props {
    font: FontValueType;
}

export const getStaticPaths = (() => {
    const availableFonts: FontValueType[] = Object.values(FontValues);

    return availableFonts.map((font: FontValueType) => ({
        params: { font: font.split(" ").join("-") },
        props: { font: font },
    }));
}) satisfies GetStaticPaths;

const { font } = Astro.props;
---

<BaseLayout>
    <IndexLayout font={font} />
</BaseLayout>
