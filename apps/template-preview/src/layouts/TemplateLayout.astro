---
import Sidebar from "../components/Sidebar.astro";
import type { Template } from "@jstmemit/shared/models/Template";
import Slots from "../components/Slots.astro";
import Examples from "../components/Examples.astro";
import type { TemplateTopic } from "@jstmemit/shared/models/TemplateTopic";
import type { TemplateProps } from "@jstmemit/shared/models/TemplateProps";
import type { FontValueType } from "@jstmemit/shared/models/Font";
import { variants } from "../data/variants.ts";
import type { IFontsRepository } from "@jstmemit/shared/interfaces/IFontsRepository";
import { FontsRepository } from "@jstmemit/shared/repositories/FontsRepository";
import type { IFontsService } from "@jstmemit/shared/interfaces/IFontsService";
import { FontsService } from "@jstmemit/shared/services/FontsService";

interface Props {
    font?: FontValueType;
    topic: TemplateTopic | "all";
    template: Template;
}

const fontsRepository: IFontsRepository = new FontsRepository();
const fontsService: IFontsService = new FontsService(fontsRepository);
const { font = "default", topic, template } = Astro.props;
---

<div class="flex flex-col gap-10 md:flex-row">
    <Sidebar currentTopic={topic} currentFont={font} currentTemplateName={template.name} />
    <hr class="text-neon-ice/25" />
    <section class="flex w-full min-w-0 flex-col gap-10">
        <div class="flex flex-col gap-1">
            <h1 class="mb-2 w-full truncate text-3xl font-black md:text-4xl">{template.name}</h1>
            <p class="border-hot-fuchsia border-l-2 pl-4 tabular-nums">
                <b>Width:</b>
                {template.width}px
            </p>
            <p class="border-hot-fuchsia border-l-2 pl-4 tabular-nums"><b>Height:</b> {template.height}px</p>
        </div>

        <Slots title="Topics" slots={template.topics} />
        <Slots title="Types" slots={template.types} />
        <Slots title="Text slots" slots={template.texts} />
        <Slots title="Image slots" slots={template.images} />

        <Examples
            variants={variants.map((variant: Omit<TemplateProps, "font">) => ({
                texts: variant.texts,
                images: variant.images,
                font: fontsService.getFontFamiliesForSetting(font),
            }))}
            template={template}
        />
    </section>
</div>
