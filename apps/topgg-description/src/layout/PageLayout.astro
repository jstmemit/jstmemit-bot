---
import Navbar from "#/components/Navbar.astro";
import "#/styles/global.css";
import "@fontsource-variable/plus-jakarta-sans";
import plusJakartaSansWoff2 from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2";
import jetBrainsMono from "#/fonts/JetBrainsMono-Regular.woff2";
import Posthog from "#/components/Posthog.astro";
import Footer from "#/components/Footer.astro";
import { getBreadcrumbListJsonLd } from "#/helpers/jsonLd/getBreadcrumbListJsonLd.ts";

interface Props {
    title: string;
    canonical: string;
    isMain?: boolean;
}

const { title, canonical, isMain } = Astro.props;

const breadcrumb = getBreadcrumbListJsonLd(canonical, title);
---

<html
    lang="en"
    class="scrollbar-thumb-bubblegum-pink scrollbar-track-carbon-black box-border scrollbar-thin overflow-x-hidden scroll-smooth"
>
    <head>
        <meta
            http-equiv="Delegate-CH"
            content="sec-ch-dpr https://jstmemit.com; sec-ch-viewport-width https://jstmemit.com"
        />
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="generator" content={Astro.generator} />

        <meta name="robots" content="index, follow, max-image-preview:large" />

        <link rel="preload" as="font" type="font/woff2" href={plusJakartaSansWoff2} crossorigin />
        <link rel="preload" as="font" type="font/woff2" href={jetBrainsMono} crossorigin />

        <meta property="og:site_name" content="Jstmemit" />
        <meta property="og:title" content={title} />
        <meta
            property="og:description"
            content="Automatically generates memes from your server's own messages and images. Free, open source and off by default until you /enable it."
        />
        <meta
            property="og:image"
            content="https://jstmemit.com/cdn-cgi/image/format=auto,fit=cover,metadata=none,sharpen=1,onerror=redirect,quality=90,slow-connection-quality=30,width=1200,height=630/https://files.jstmemit.com/jstmemit/images/og.png"
        />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content="Two blurred example memes, heading 'Personalized memes for your community' and 'auto-generate memes from your conversations' subtext"
        />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="en_US" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta
            name="twitter:description"
            content="Automatically generates memes from your server's own messages and images. Free, open source and off by default."
        />
        <meta
            name="twitter:image"
            content="https://jstmemit.com/cdn-cgi/image/format=auto,fit=cover,metadata=none,sharpen=1,onerror=redirect,quality=90,slow-connection-quality=30,width=1200,height=630/https://files.jstmemit.com/jstmemit/images/og.png"
        />
        <meta
            name="twitter:image:alt"
            content="Two blurred example memes, heading 'Personalized memes for your community' and 'auto-generate memes from your conversations' subtext"
        />

        <title>{title}</title>
        <meta
            name="description"
            content="Automatically generates memes from your server's own messages and images. Free, open source and off by default."
        />
        <link rel="canonical" href={canonical} />

        <meta name="theme-color" content="#EC5775" />

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "Organization",
                        "@id": "https://jstmemit.com/#org",
                        name: "Jstmemit",
                        url: "https://jstmemit.com",
                        logo: {
                            "@type": "ImageObject",
                            "@id": "https://jstmemit.com/#logo",
                            url: "https://files.jstmemit.com/jstmemit/images/logos/logo.png",
                            caption: "Jstmemit logo",
                        },
                        contactPoint: [
                            {
                                "@type": "ContactPoint",
                                contactType: "customer support",
                                url: "https://discord.gg/THRnn8fhkZ",
                            },
                            { "@type": "ContactPoint", contactType: "privacy", email: "privacy@jstmemit.com" },
                        ],
                        legalName: "Wide Units",
                        identifier: {
                            "@type": "PropertyValue",
                            propertyID: "KVK",
                            value: "97552887",
                        },
                        sameAs: [
                            "https://github.com/jstmemit",
                            "https://top.gg/bot/1375836467745783990",
                            "https://discord.gg/THRnn8fhkZ",
                        ],
                    },
                    {
                        "@type": "WebSite",
                        "@id": "https://jstmemit.com/#website",
                        url: "https://jstmemit.com",
                        name: "Jstmemit",
                        publisher: { "@id": "https://jstmemit.com/#org" },
                        inLanguage: "en",
                    },
                    {
                        "@type": "WebPage",
                        "@id": canonical + "#webpage",
                        url: canonical,
                        name: title,
                        isPartOf: { "@id": "https://jstmemit.com/#website" },
                        about: { "@id": "https://jstmemit.com/#app" },
                        primaryImageOfPage: { "@id": "https://jstmemit.com/#logo" },
                        ...(isMain ? { hasPart: { "@id": "https://jstmemit.com/#faq" } } : {}),
                        ...(isMain ? {} : { breadcrumb: { "@id": canonical + "#breadcrumb" } }),
                        inLanguage: "en",
                    },
                    {
                        "@type": "SoftwareApplication",
                        "@id": "https://jstmemit.com/#app",
                        name: "Jstmemit",
                        url: "https://jstmemit.com",
                        description:
                            "Discord bot that automatically generates memes from your server's own messages and images.",
                        image: "https://files.jstmemit.com/jstmemit/images/logos/logo.png",
                        applicationCategory: "UtilitiesApplication",
                        applicationSubCategory: "Discord bot",
                        operatingSystem: "Discord",
                        softwareVersion: "1.4.0",
                        datePublished: "2026-07-06",
                        dateModified: new Date().toISOString(),
                        license: "https://opensource.org/licenses/MIT",
                        isAccessibleForFree: true,
                        inLanguage: "en",
                        author: { "@id": "https://jstmemit.com/#org" },
                        publisher: { "@id": "https://jstmemit.com/#org" },
                        installUrl: "https://discord.com/oauth2/authorize?client_id=1375836467745783990",
                        downloadUrl: "https://github.com/jstmemit/jstmemit",
                        softwareHelp: "https://discord.gg/THRnn8fhkZ",
                        featureList: [
                            "Auto-generates memes from your channel's own messages, images and GIFs",
                            "More than 660 meme templates",
                            "Animated meme templates",
                            "Commands are translated into 13 languages",
                            "Custom memes with your own text and images via /custom",
                            "Turn any message or user profile into a meme via right-click actions",
                            "Off by default, enabled per channel",
                            "No usage limits and no watermarks",
                            "Supports PNG, JPEG, WEBP, AVIF, GIF and more as input",
                        ],
                        screenshot: [
                            "https://files.jstmemit.com/jstmemit/images/topgg/cinemaGuys.png",
                            "https://files.jstmemit.com/jstmemit/images/topgg/spongebobCaveman.png",
                        ],
                        offers: {
                            "@type": "Offer",
                            price: "0",
                            priceCurrency: "EUR",
                            availability: "https://schema.org/InStock",
                        },
                    },
                    {
                        "@type": "SoftwareSourceCode",
                        "@id": "https://jstmemit.com/#source",
                        name: "Jstmemit",
                        programmingLanguage: "TypeScript",
                        codeRepository: "https://github.com/jstmemit/jstmemit",
                        license: "https://opensource.org/licenses/MIT",
                        targetProduct: { "@id": "https://jstmemit.com/#app" },
                        maintainer: { "@id": "https://jstmemit.com/#org" },
                    },
                    ...(isMain ? [] : [breadcrumb]),
                ],
            })}
        />

        <Posthog />
    </head>
    <body class="bg-carbon-black relative overflow-x-hidden leading-8 tracking-wide sm:leading-7">
        <header class="fixed top-0 z-15 w-full px-6 md:px-10">
            <Navbar />
        </header>

        <div class="fixed top-0 z-3 h-10 w-screen bg-linear-to-t from-transparent to-black/20" aria-hidden="true"></div>

        <main role="main">
            <slot />
        </main>

        <footer>
            <Footer />
        </footer>

        <div class="fixed bottom-0 z-3 h-10 w-screen bg-linear-to-b from-transparent to-black/20" aria-hidden="true">
        </div>
    </body>
</html>
