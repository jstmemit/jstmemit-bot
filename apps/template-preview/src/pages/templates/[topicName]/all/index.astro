---
import type { GetStaticPaths } from "astro";
import type { ITemplatesRepository } from "@jstmemit/shared/interfaces/ITemplatesRepository";
import { TemplatesRepository } from "@jstmemit/shared/repositories/TemplatesRepository";
import type { Template } from "@jstmemit/shared/models/Template";
import BaseLayout from "@/layouts/BaseLayout.astro";
import TemplatesList from "@/components/TemplatesList.astro";
import type { TemplateTopic } from "@jstmemit/shared/models/TemplateTopic";

interface Props {
    topic: TemplateTopic;
    templates: Template[];
}

export const getStaticPaths = (() => {
    const templatesRepository: ITemplatesRepository = new TemplatesRepository();
    const allTemplates: Template[] = templatesRepository.getAll();
    const uniqueTopics: TemplateTopic[] = Array.from(
        new Set(allTemplates.flatMap((template: Template) => template.topics)),
    );

    return uniqueTopics.map((topic) => {
        const filteredTemplates = allTemplates.filter((template: Template) => template.topics.includes(topic));

        return {
            params: { topicName: topic },
            props: { topic, templates: filteredTemplates },
        };
    });
}) satisfies GetStaticPaths;

const { topic, templates } = Astro.props;
---

<BaseLayout>
    <TemplatesList templates={templates} />
</BaseLayout>
