---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import IndexLayout from "@/layouts/IndexLayout.astro";
import { type TemplateTopic, Topic } from "@jstmemit/shared/models/TemplateTopic";
import { FontValues, type FontValueType } from "@jstmemit/shared/models/Font";

interface Props {
    font: FontValueType;
    topic: TemplateTopic;
}

export const getStaticPaths = (() => {
    const availableFonts: FontValueType[] = Object.values(FontValues);

    return availableFonts.flatMap((font: FontValueType) =>
        Object.values(Topic).map((topic: TemplateTopic) => ({
            params: {
                font: font.split(" ").join("-"),
                topicName: topic,
            },
            props: {
                font: font,
                topic: topic,
            },
        })),
    );
}) satisfies GetStaticPaths;

const { font, topic } = Astro.props;
---

<BaseLayout>
    <IndexLayout font={font} topic={topic} />
</BaseLayout>
