---
import type { GetStaticPaths, Page } from "astro";
import type { ITemplatesRepository } from "@jstmemit/shared/interfaces/ITemplatesRepository";
import { TemplatesRepository } from "@jstmemit/shared/repositories/TemplatesRepository";
import type { Template } from "@jstmemit/shared/models/Template";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import TemplatesList from "../../../../../components/TemplatesList.astro";
import { type FontValueType, FontValues } from "@jstmemit/shared/models/Font.ts";
import type { TemplateTopic } from "@jstmemit/shared/models/TemplateTopic";

interface Props {
    font: FontValueType;
    topic: TemplateTopic;
    page: Page<Template>;
}

export const getStaticPaths = (({ paginate }) => {
    const templatesRepository: ITemplatesRepository = new TemplatesRepository();
    const allTemplates: Template[] = templatesRepository.getAll();
    const uniqueTopics: TemplateTopic[] = Array.from(new Set(allTemplates.flatMap((t: Template) => t.topics)));
    const availableFonts: FontValueType[] = Object.values(FontValues);

    return availableFonts.flatMap((font: FontValueType) => {
        return uniqueTopics.flatMap((topic: TemplateTopic) => {
            const filteredTemplates: Template[] = allTemplates.filter((template: Template) =>
                template.topics.includes(topic),
            );

            return paginate(filteredTemplates, {
                params: { font: font.split(" ").join("-"), topicName: topic },
                props: { font, topic },
                pageSize: 50,
            });
        });
    });
}) satisfies GetStaticPaths;

const templates: Template[] = Astro.props.page.data;
const { font, topic } = Astro.props;
---

<BaseLayout>
    <TemplatesList font={font} templates={templates} />
</BaseLayout>
